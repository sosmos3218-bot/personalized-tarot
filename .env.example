# Clerk (https://dashboard.clerk.com) — required at runtime for auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/saju
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/saju

# Vercel AI Gateway — optional; without it, /api/interpret returns template interpretations
# On Vercel, OIDC can work without a static key when AI Gateway is enabled on the project.
# Free-tier models still require a payment method on the Vercel team (customer_verification).
# Dashboard: https://vercel.com/docs/ai-gateway/getting-started
AI_GATEWAY_API_KEY=

# Optional model override (default: inclusionai/ling-3.1-flash-free — free on Gateway)
# TAROT_AI_MODEL=inclusionai/ling-3.1-flash-free

# Build notes:
# - `next build` needs NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY in .env.local
# - Use real Clerk *test* keys from the dashboard for local auth.
# - For CI typecheck/build only, keys must match Clerk's pk_test_/sk_test_ format
#   (base64-shaped). Invalid placeholders make prerender fail.
# - Do NOT commit .env.local. Do not invent or commit real secrets.
# - Runtime login and AI need real keys; format-only placeholders are not enough to sign in.

# Vercel Blob (private store) — auto-set on Vercel when store is connected
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Daily email reminder (Resend) — optional; cron skips send if missing
RESEND_API_KEY=
RESEND_FROM_EMAIL=Starlight Tarot <onboarding@resend.dev>
# Optional: protect /api/cron/daily-reminder (Vercel Cron can use CRON_SECRET)
CRON_SECRET=

# Web Push (VAPID) — generate with: npx web-push generate-vapid-keys
# Never commit private key. Public key is safe in NEXT_PUBLIC_*.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:noreply@personalized-tarot.vercel.app
