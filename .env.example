# Clerk (https://dashboard.clerk.com) — required at runtime for auth
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/onboarding
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# Vercel AI Gateway — optional; without it, /api/interpret returns template interpretations
AI_GATEWAY_API_KEY=

# Build notes:
# - `next build` needs NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY + CLERK_SECRET_KEY in .env.local
# - Use real Clerk *test* keys from the dashboard for local auth.
# - For CI typecheck/build only, keys must match Clerk's pk_test_/sk_test_ format
#   (base64-shaped). Invalid placeholders make prerender fail.
# - Do NOT commit .env.local. Do not invent or commit real secrets.
# - Runtime login and AI need real keys; format-only placeholders are not enough to sign in.
